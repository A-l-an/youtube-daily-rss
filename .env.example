# Required for DeepSeek official API summaries.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional: legacy HKUST-GZ credentials only if asr.provider is switched back.
HKUST_GZ_API_KEY=
HKUST_GZ_BASE_URL=https://gpt-api.hkust-gz.edu.cn/v1

# Optional: override the summary and ASR models from config.yml.
SUMMARY_MODEL=deepseek-flash
ASR_MODEL=large-v3-turbo

# Optional fallback if you switch providers to OpenAI in config.yml.
OPENAI_API_KEY=

# Optional and currently unused. YouTube Atom feeds do not require an API key.
YOUTUBE_API_KEY=
